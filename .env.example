# 医药销售管理系统 —— 配置模板
#
# 用法：cp .env.example .env 后按需修改（.env 已在 .gitignore 中，不会被提交）。
# 所有变量都有默认值，因此什么都不改也能直接 `docker compose up -d --build` 跑起来。

# ---------------- 宿主机端口 ----------------
# 数据库端口；db/ 下的造数脚本默认连 127.0.0.1:5688，改这里时脚本要用 MEDSALESDB_PORT 同步
MEDSALES_DB_PORT=5688
MEDSALES_API_PORT=8001
MEDSALES_WEB_PORT=8088
MEDSALES_MINIO_API_PORT=9020
MEDSALES_MINIO_CONSOLE_PORT=9021

# ---------------- 时区 ----------------
# 影响 now()/date.today()：经营看板「今日」、应收账龄、证照到期天数都按本地日期计算。
# 数据库容器的 TZ 只在首次 initdb 时写入配置，已有库需 ALTER SYSTEM SET timezone（见文档）
TZ=Asia/Shanghai

# ---------------- 数据库 ----------------
POSTGRES_USER=postgres
# 演示用默认口令，生产环境必须更换
POSTGRES_PASSWORD=pass01!
POSTGRES_DB=medsalesdb
# 初始化参数：UTF-8 编码 + 中文拼音排序（ICU 排序规则）。
# 仅在该数据卷为空、首次 initdb 时生效；改动后必须重建数据卷，见 docs/数据库部署与配置.md
POSTGRES_INITDB_ARGS=--locale-provider=icu --icu-locale=zh-u-co-pinyin --encoding=UTF8
# 改了 POSTGRES_PASSWORD 时，取消下面这行的注释并写入相同口令
# （容器内部地址固定为 medsales-db:5432；接外部数据库时也在这里改）
# DATABASE_URL=postgresql+asyncpg://postgres:你的口令@medsales-db:5432/medsalesdb

# ---------------- 安全（生产环境必须更换） ----------------
# 令牌签名密钥，建议 32 位以上随机串：openssl rand -hex 32
JWT_SECRET=medsales-change-me-to-a-long-random-secret-please
# 系统对接 API Key，逗号分隔可配多个（便于轮换），留空表示不开放对接
SYS_API_KEYS=
# 允许的跨域来源，逗号分隔；生产环境不要用 *
CORS_ORIGINS=*

# ---------------- 对象存储（MinIO） ----------------
MINIO_ROOT_USER=medsales
MINIO_ROOT_PASSWORD=medsales-minio-secret
S3_BUCKET=medsales
S3_REGION=us-east-1

# ---------------- GSP 交易准入校验 ----------------
# 已建档主体的证照过期/待审核/驳回时禁止交易
GSP_ENFORCE_QUALIFICATION=true
# 严格模式：完全未建档的主体同样禁止交易
GSP_STRICT_QUALIFICATION=false
# 「即将到期」预警阈值（天）
GSP_EXPIRY_WARNING_DAYS=90
