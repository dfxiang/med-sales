# 数据库连接（demo-db 容器映射到宿主机 5688 端口）
DATABASE_URL=postgresql+asyncpg://postgres:pass01!@127.0.0.1:5688/medsalesdb

# JWT 配置
JWT_SECRET=medsales-change-me-to-a-long-random-secret-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 系统间对接 API Key（逗号分隔支持多个，构建/启动容器时通过环境变量指定）
SYS_API_KEYS=

# 服务配置
APP_NAME=medsales-api
DEBUG=true
CORS_ORIGINS=*
